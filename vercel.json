{
  "cleanUrls": true,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "private, max-age=3600" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "private, no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "private, no-cache" }] }
  ]
}
